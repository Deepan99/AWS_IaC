# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files you always want to have LF (crucial for Linux UserData scripts)
*.sh text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
