# ==============================================================================
# Terraform Backend Configuration Example
# ==============================================================================
# This file shows how to configure remote state storage for team collaboration.
# Rename this file to backend.tf and update the values before using.
#
# IMPORTANT: This configuration uses AWS S3 + DynamoDB for remote state.
# This incurs minimal cost (~$0.023/GB for S3, ~$1.25/mo for DynamoDB).
# If you want to keep it 100% free, use local state (default) or skip this file.
# ==============================================================================

terraform {
  backend "s3" {
    bucket         = "your-terraform-state-bucket-name"
    key            = "aws-hub-spoke-network/terraform.tfstate"
    region         = "ap-south-1"
    encrypt        = true
    dynamodb_table = "your-terraform-lock-table"
    
    # Optional: Enable versioning for state history
    # This helps with rollbacks and audit trails
  }
}

# ==============================================================================
# Setup Instructions (One-time setup)
# ==============================================================================
# 1. Create S3 bucket for state storage:
#    aws s3api create-bucket \
#      --bucket your-terraform-state-bucket-name \
#      --region ap-south-1 \
#      --create-bucket-configuration LocationConstraint=ap-south-1
#
# 2. Enable versioning on the bucket:
#    aws s3api put-bucket-versioning \
#      --bucket your-terraform-state-bucket-name \
#      --versioning-configuration Status=Enabled
#
# 3. Create DynamoDB table for state locking:
#    aws dynamodb create-table \
#      --table-name your-terraform-lock-table \
#      --attribute-definitions AttributeName=LockID,AttributeType=S \
#      --key-schema AttributeName=LockID,KeyType=HASH \
#      --billing-mode PAY_PER_REQUEST \
#      --region ap-south-1
#
# 4. Rename this file to backend.tf and update bucket/table names
#
# 5. Run: terraform init
# ==============================================================================

# ==============================================================================
# Alternative: Local State (Free, No Setup Required)
# ==============================================================================
# If you want to use local state (default), simply delete or ignore this file.
# Terraform will use local state file: terraform/terraform.tfstate
#
# Note: Local state is fine for single-person projects but not recommended for teams.
# ==============================================================================
